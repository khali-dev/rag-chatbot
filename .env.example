# Sprachmodell-Anbieter:
# ollama = lokales Modell
# gemini = Cloud-Modell
LLM_PROVIDER=ollama

# Lokales Ollama-Modell
OLLAMA_MODEL=qwen3:4b

# Cloud-Modell
GEMINI_MODEL=gemini-3.5-flash-lite

# Niemals einen echten Schlüssel in dieser Beispieldatei speichern.
GEMINI_API_KEY=

# Maximale Anzahl Cloud-Fragen pro Browsersitzung
MAX_QUESTIONS_PER_SESSION=20

# true zeigt technische Fehlerdetails an.
# In der veröffentlichten Version immer false verwenden.
RAG_DEBUG=false

# Optionaler Hugging-Face-Schlüssel
HF_TOKEN=