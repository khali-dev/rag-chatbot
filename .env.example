# Sprachmodell-Anbieter:
# ollama = lokales Modell
# gemini = Cloud-Modell
LLM_PROVIDER=ollama

# Lokales Ollama-Modell
OLLAMA_MODEL=qwen3:4b

# Cloud-Modell
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional für direkte lokale Gemini-Tests.
# Niemals einen echten Schlüssel hier eintragen.
GEMINI_API_KEY=

# Maximale Anzahl Fragen pro Cloud-Sitzung
MAX_QUESTIONS_PER_SESSION=20

# In der veröffentlichten Version immer false
RAG_DEBUG=false

# Optionaler Hugging-Face-Schlüssel
HF_TOKEN=